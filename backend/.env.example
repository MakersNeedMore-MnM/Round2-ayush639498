PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/rashak

# Signs session cookies and bearer tokens. MUST be a long random value in production.
JWT_SECRET=generate_a_long_random_secret_here
JWT_EXPIRES_IN=7d

# Prototype role entry does not use a password or shared access code.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Comma separated list of exact frontend origins allowed to call this API with credentials.
CLIENT_URL=http://localhost:5173

# Poll public feeds every 5 minutes. Set false to disable background ingestion.
AUTO_INGEST=true
INGEST_INTERVAL_MS=300000
INGEST_CRON=*/15 * * * *
# Optional: direct IMD district-warning object IDs, only if verified from IMD's current API list.
IMD_DISTRICT_IDS_JSON={}
# Backend always keeps a populated operational fallback dataset. MongoDB is preferred when complete.
DEMO_DATA_FALLBACK=true

# Local development convenience ONLY — ignored automatically when NODE_ENV=production.
DEMO_BYPASS_AUTH=false

# Set to "false" to explicitly disable CSRF double-submit checks (never do this in production).
CSRF_PROTECTION=true
